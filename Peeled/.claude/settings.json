{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "model": "claude-opus-4-7",
  "env": {
    "CLAUDE_CODE_ENABLE_THINKING": "1",
    "CLAUDE_CODE_THINKING_LEVEL": "max",
    "CLAUDE_CODE_MAX_OUTPUT_TOKENS": "16384",
    "PEELED_ENV": "local",
    "PYTHONDONTWRITEBYTECODE": "1",
    "PYTHONUNBUFFERED": "1"
  },
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Read(**)",
      "Write(**)",
      "Edit(**)",
      "Glob(**)",
      "Grep(**)",
      "WebFetch(domain:docs.flutter.dev)",
      "WebFetch(domain:api.flutter.dev)",
      "WebFetch(domain:pub.dev)",
      "WebFetch(domain:fastapi.tiangolo.com)",
      "WebFetch(domain:supabase.com)",
      "WebFetch(domain:docs.mapbox.com)",
      "WebFetch(domain:firebase.google.com)",
      "WebFetch(domain:docs.anthropic.com)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "WebSearch",
      "Bash(flutter *)",
      "Bash(dart *)",
      "Bash(fvm *)",
      "Bash(pub *)",
      "Bash(python *)",
      "Bash(python3 *)",
      "Bash(pip *)",
      "Bash(pip3 *)",
      "Bash(uv *)",
      "Bash(uvx *)",
      "Bash(uvicorn *)",
      "Bash(pytest *)",
      "Bash(ruff *)",
      "Bash(mypy *)",
      "Bash(black *)",
      "Bash(isort *)",
      "Bash(pre-commit *)",
      "Bash(docker *)",
      "Bash(docker compose *)",
      "Bash(docker-compose *)",
      "Bash(psql *)",
      "Bash(pg_dump *)",
      "Bash(redis-cli *)",
      "Bash(supabase *)",
      "Bash(npm *)",
      "Bash(npx *)",
      "Bash(pnpm *)",
      "Bash(yarn *)",
      "Bash(node *)",
      "Bash(git status)",
      "Bash(git status:*)",
      "Bash(git diff)",
      "Bash(git diff:*)",
      "Bash(git log)",
      "Bash(git log:*)",
      "Bash(git show)",
      "Bash(git show:*)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git branch *)",
      "Bash(git checkout *)",
      "Bash(git switch *)",
      "Bash(git fetch *)",
      "Bash(git pull *)",
      "Bash(git push *)",
      "Bash(git stash *)",
      "Bash(git restore *)",
      "Bash(git reset *)",
      "Bash(git merge *)",
      "Bash(git rebase *)",
      "Bash(git worktree *)",
      "Bash(gh *)",
      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(pwd)",
      "Bash(which *)",
      "Bash(mkdir *)",
      "Bash(cp *)",
      "Bash(mv *)",
      "Bash(chmod *)",
      "Bash(curl *)",
      "Bash(wget *)",
      "Bash(tar *)",
      "Bash(unzip *)",
      "Bash(zip *)"
    ],
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/*service-account*.json)",
      "Read(**/id_rsa)",
      "Read(**/id_ed25519)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~)",
      "Bash(rm -rf ~/*)",
      "Bash(rm -rf $HOME*)",
      "Bash(sudo rm -rf *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git reset --hard origin/main)",
      "Bash(git reset --hard origin/master)",
      "Bash(git branch -D main)",
      "Bash(git branch -D master)",
      "Bash(docker system prune -af *)",
      "Bash(dd if=*)",
      "Bash(mkfs*)",
      "Bash(shutdown *)",
      "Bash(reboot *)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash -lc 'echo \"[PEELED] session starting at $(date -u +%FT%TZ) on branch $(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo detached)\"; echo \"[PEELED] reminder: read CLAUDE.md + docs/GDD.md + docs/ARCHITECTURE.md before coding\"; echo \"[PEELED] think ultra-hard. TDD server game logic. Update CLAUDE.md on non-trivial change.\"'"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash -lc 'f=\"$CLAUDE_TOOL_INPUT_file_path\"; case \"$f\" in *.dart) (cd \"$(git rev-parse --show-toplevel)/Peeled/app\" && dart format \"$f\" >/dev/null 2>&1 && dart analyze \"$f\" 2>&1 | tail -20) ;; *.py) (cd \"$(git rev-parse --show-toplevel)/Peeled/server\" && ruff check --fix \"$f\" 2>&1 | tail -20; ruff format \"$f\" >/dev/null 2>&1) ;; *.sql) echo \"[hint] run: psql \\$DATABASE_URL -f $f against a disposable db\" ;; esac'"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash -lc 'echo \"[PEELED] stopping. If work is done: (1) pytest + flutter test, (2) update CLAUDE.md + docs/ROADMAP.md, (3) commit on a feature branch, (4) open PR.\"'"
          }
        ]
      }
    ]
  }
}
