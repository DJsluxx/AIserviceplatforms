# ======= PEELED server .env =======

# Environment
PEELED_ENV=local
LOG_LEVEL=INFO

# Core data
DATABASE_URL=postgresql+asyncpg://peeled:peeled@localhost:5432/peeled
REDIS_URL=redis://localhost:6379/0

# Supabase (optional in dev)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_JWT_SECRET=

# Tokens & secrets — regenerate for prod; NEVER commit real values
JWT_SECRET=change-me-dev-jwt-secret-at-least-32-chars
ANTI_CHEAT_SIGNING_SECRET=change-me-dev-ac-secret-at-least-32-chars

# Push (base64-encoded FCM service account JSON)
FCM_SERVICE_ACCOUNT_JSON=

# Observability
SENTRY_DSN=

# Maps
MAPBOX_TOKEN=

# ======= Flutter client (app/.env) =======
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# SERVER_BASE_URL=http://localhost:8000
# MAPBOX_PUBLIC_TOKEN=
# POSTHOG_KEY=
